    <link rel="icon" type="image/svg+xml" href="{{ asset('/favicon/favicon.svg') }}" />
    <link rel="shortcut icon" href="{{ asset('/favicon/favicon.ico') }}" />
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('/favicon/apple-touch-icon.png') }}" />
    <link rel="manifest" href="{{ asset('/favicon/site.webmanifest') }}" />
    <link href="{{ asset('styles/app.css') }}" rel="stylesheet">
    <title>register - connectory</title>
    <style>
        .error-field {
            border: 1px solid #ff0000 !important;
        }
        .error-message {
            color: #ff0000;
            font-size: 12px;
            margin-bottom: 8px;
            min-height: 14px;
        }
    </style>
</head>
<body>
<div class="header">
    <table style="width:100%;">
        <tr>
            <td style="width:50%; text-align:left;">
                <img src="{{ asset('img/logo.png') }}" alt="Logo" style="height:42.5px; padding-bottom:13px;">
            </td>
            <td style="width:50%; text-align:right; vertical-align:top; position:relative;">
                <div style="display: flex; justify-content: flex-end; align-items: start; gap: 13px;">
                    <div style="display: flex; flex-direction: column; align-items: flex-end; margin-right: 13px;">
                        <div style="margin-bottom:4px;">
                            <input type="text" placeholder="Search..." style="padding:4px; width:340px; margin-right:4px;">
                            <button type="button" class="search" style="background: linear-gradient(to top, #4B0082,rgb(146, 86, 206)); color:white; padding:4px 8px; text-decoration:none; border:1px solid #b366ff; font-size: 0.85em;">Search</button>
                        </div>
                        <div style="font-size: 0.85em;">
                            <a href="{{ path('login') }}" style="color:#4B0082; text-decoration:none; margin-right: 8px;">login</a>
                            <a href="{{ path('register') }}" style="color:#4B0082; text-decoration:none;">sign up</a>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
    </table>
</div>

<div class="content" style="background:white; height: 85vh;">
    <div style="display: flex; width: 100%; height: 100%;">

        <!-- Main content -->
        <div style="flex: 1; padding: 8.5px;">
            <div>
                <div style="border: 0.85px solid #ccc; padding: 12.75px; height: 170px; margin-bottom: 17px;">
                    <h3>Registration!!!!</h3>
                    <p>information about the site and stuff here</p>
                </div>
            </div>
        </div>

<!-- Third column -->
<div style="width: 21.25%; padding: 0.53125rem; border-left: 0.053125rem solid #eee;">
    <div style="background: #f7f7f7; border: 0.053125rem solid #ccc; padding: 0.796875rem; margin-bottom: 1.0625rem;">
        <div style="margin-bottom: 0.796875rem;">
            <form method="POST" action="{{ path('register_handler') }}" id="registrationForm">
                <h3 style="color: #4B0082; font-size: 0.74375rem; margin-bottom: 0.265625rem;">Username:</h3>
                <input type="text"
                       name="username"
                       id="username_field"
                       placeholder="Username"
                       required
                       value="{{ old_data.username|default('') }}"
                       class="{{ errors.username is defined ? 'error-field' : '' }}"
                       style="width: 95%;
                           padding: 0.31875rem;
                           border: 0.053125rem solid #ccc;
                           border-radius: 0;
                           margin-bottom: 0.265625rem;" />
                <div id="errortxt_field_username" class="error-message">{{ errors.username|default('') }}</div>

                <h3 style="color: #4B0082; font-size: 0.74375rem; margin-bottom: 0.265625rem;">Email Address:</h3>
                <input type="text"
                       name="email"
                       id="email_field"
                       placeholder="E-Mail Address"
                       required
                       value="{{ old_data.email|default('') }}"
                       class="{{ errors.email is defined ? 'error-field' : '' }}"
                       style="width: 95%;
                           padding: 0.31875rem;
                           border: 0.053125rem solid #ccc;
                           border-radius: 0;
                           margin-bottom: 0.265625rem;" />
                <div id="errortxt_field_email" class="error-message">{{ errors.email|default('') }}</div>

                <h3 style="color: #4B0082; font-size: 0.74375rem; margin-bottom: 0.265625rem;">Phone Number:</h3>
                <input type="text"
                       name="phone"
                       id="phone_field"
                       placeholder="+1 "
                       value="{{ old_data.phone|default('') }}"
                       class="{{ errors.phone is defined ? 'error-field' : '' }}"
                       style="width: 95%;
                           padding: 0.31875rem;
                           border: 0.053125rem solid #ccc;
                           border-radius: 0;
                           margin-bottom: 0.265625rem;" />
                <div id="errortxt_field_phone" class="error-message">{{ errors.phone|default('') }}</div>

                <h3 style="color: #4B0082; font-size: 0.74375rem; margin-bottom: 0.265625rem;">Password:</h3>
                <input type="password"
                       name="password"
                       id="password_field"
                       placeholder="Password"
                       required
                       class="{{ errors.password is defined ? 'error-field' : '' }}"
                       style="width: 95%;
                           padding: 0.31875rem;
                           border: 0.053125rem solid #ccc;
                           border-radius: 0;
                           margin-bottom: 0.265625rem;" />
                <div id="errortxt_field_password" class="error-message">{{ errors.password|default('') }}</div>

                <h3 style="color: #4B0082; font-size: 0.74375rem; margin-bottom: 0.265625rem;">Confirm Password:</h3>
                <input type="password"
                       name="confirm_password"
                       id="confirm_password_field"
                       placeholder="Confirm Password"
                       required
                       class="{{ errors.confirm_password is defined ? 'error-field' : '' }}"
                       style="width: 95%;
                           padding: 0.31875rem;
                           border: 0.053125rem solid #ccc;
                           border-radius: 0;
                           margin-bottom: 0.265625rem;" />
                <div id="errortxt_field_confirm_password" class="error-message">{{ errors.confirm_password|default('') }}</div>
            
                <button type="submit" 
                    name="button" 
                    style="width: 100%;
                    background: linear-gradient(to top, #4B0082, rgb(146, 86, 206));
                    color: white;
                    padding: 0.31875rem 0;
                    border: none;
                    border-radius: 0;
                    cursor: pointer;">Register</button>
                
            </form>
        </div>
    </div>

    <div style="border: 0.053125rem solid #ccc; padding: 0.796875rem;">
        <h3>Site Updates</h3>
        <p>updates and stuff go here</p>
    </div>
</div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('registrationForm');
    
    const fields = {
        username: {
            element: document.getElementById('username_field'),
            error: document.getElementById('errortxt_field_username'),
            validate: function(value) {
                if (!value) return 'Username cannot be empty';
                if (value.length < 3) return 'Username must be at least 3 characters';
                return '';
            }
        },
        email: {
            element: document.getElementById('email_field'),
            error: document.getElementById('errortxt_field_email'),
            validate: function(value) {
                if (!value) return 'Email cannot be empty';
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(value)) return 'Invalid email format';
                return '';
            }
        },
        phone: {
            element: document.getElementById('phone_field'),
            error: document.getElementById('errortxt_field_phone'),
            validate: function(value) {
                if (!value) return ''; // Phone is optional
                const phoneRegex = /^\+?[0-9\s\-\(\)]{8,20}$/;
                if (!phoneRegex.test(value)) return 'Invalid phone number format';
                return '';
            }
        },
        password: {
            element: document.getElementById('password_field'),
            error: document.getElementById('errortxt_field_password'),
            validate: function(value) {
                if (!value) return 'Password cannot be empty';
                if (value.length < 8) return 'Password must be at least 8 characters';
                return '';
            }
        },
        confirm_password: {
            element: document.getElementById('confirm_password_field'),
            error: document.getElementById('errortxt_field_confirm_password'),
            validate: function(value) {
                const password = document.getElementById('password_field').value;
                if (value !== password) return 'Passwords do not match';
                return '';
            }
        }
    };
    
    // Add input event listeners to clear errors when fields are changed
    for (const key in fields) {
        fields[key].element.addEventListener('input', function() {
            fields[key].element.classList.remove('error-field');
            fields[key].error.textContent = '';
            
            // Special case for password and confirm password
            if (key === 'password' || key === 'confirm_password') {
                // Re-validate confirm password when either password field changes
                const confirmField = fields['confirm_password'];
                const passwordField = fields['password'];
                
                // Only check if both fields have values
                if (confirmField.element.value && passwordField.element.value) {
                    const errorMessage = confirmField.validate(confirmField.element.value);
                    if (errorMessage) {
                        confirmField.element.classList.add('error-field');
                        confirmField.error.textContent = errorMessage;
                    } else {
                        confirmField.element.classList.remove('error-field');
                        confirmField.error.textContent = '';
                    }
                }
            }
        });
    }
    
    form.addEventListener('submit', function(e) {
        let hasErrors = false;
        
        // Clear previous errors
        for (const key in fields) {
            fields[key].element.classList.remove('error-field');
            fields[key].error.textContent = '';
        }
        
        // Validate all fields
        for (const key in fields) {
            const field = fields[key];
            const errorMessage = field.validate(field.element.value);
            
            if (errorMessage) {
                field.element.classList.add('error-field');
                field.error.textContent = errorMessage;
                hasErrors = true;
            }
        }
        
        if (hasErrors) {
            e.preventDefault();
        }
    });
});
</script>

</body>
</html>
