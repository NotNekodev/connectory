<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/png" href="{{ asset('/favicon/favicon-96x96.png') }}" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="{{ asset('/favicon/favicon.svg') }}" />
    <link rel="shortcut icon" href="{{ asset('/favicon/favicon.ico') }}" />
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('/favicon/apple-touch-icon.png') }}" />
    <link rel="manifest" href="{{ asset('/favicon/site.webmanifest') }}" />
    <link href="{{ asset('styles/app.css') }}" rel="stylesheet">
    <title>connectory</title>
    <style>
        .error-field {
            border: 1px solid #ff0000 !important;
        }
        .error-message {
            color: #ff0000;
            font-size: 12px;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>
<div class="header">
    <table style="width:100%;">
        <tr>
            <td style="width:50%; text-align:left;">
                <img src="{{ asset('img/logo.png') }}" alt="Logo" style="height:50px; padding-bottom:15px;">
            </td>
            <td style="width:50%; text-align:right;">
                <div style="margin-bottom:10px;">
                    <input type="text" placeholder="Search..." style="padding:5px; width:70%;">
                    <button type="button" class="search" style="background: linear-gradient(to top, #4B0082,rgb(146, 86, 206)); color:white; padding:5px 10px; text-decoration:none; border:1px solid #b366ff;">Search</button>
                </div>
                <div style="padding-bottom:10px;">
                    <a href="{{ path('login') }}" style="color:#4B0082; padding:5px 10px; text-decoration:none;">login</a>
                    <a href="{{ path('register') }}" style="color:#4B0082; padding:5px 10px; text-decoration:none;">sign up</a>
                </div>
            </td>
        </tr>
    </table>
</div>

<div class="content" style="background:white; height: 100vh;">
    <div style="display: flex; width: 100%; height: 100%;">

        <!-- Main content -->
        <div style="flex: 1; padding: 10px;">
            <div>
                <div style="border: 1px solid #ccc; padding: 15px; height: 200px; margin-bottom: 20px;">
                    <h3>Welcome</h3>
                    <p>information about the site and stuff here</p>
                </div>
            </div>
        </div>

<!-- Third column -->
<div style="width: 300px; padding: 10px; border-left: 1px solid #eee;">
    <div style="background: #f7f7f7; border: 1px solid #ccc; padding: 15px; margin-bottom: 20px;">
        <div style="margin-bottom: 15px;">
            <form method="POST" action="{{ path('auth_handler') }}" id="loginForm">
            <h3 style="color: #4B0082; font-size: 14px; margin-bottom: 5px;">Email or Username:</h3>
            <input type="text" 
                id="username"
                name="username" 
                placeholder="example@mail.com" 
                required 
                value="{{ last_username|default('') }}"
                class="{{ errors is defined and errors['username'] is defined ? 'error-field' : '' }}"
                style="width: 95%;
                    padding: 6px;
                    border: 1px solid #ccc;
                    border-radius: 0;
                    margin-bottom: 5px;" />
            <div id="username_error" class="error-message">{{ errors.username|default('') }}</div>
            
            <h3 style="color: #4B0082; font-size: 14px; margin-bottom: 5px;">Password:</h3>
            <input type="password" 
                id="password"
                name="password" 
                required 
                class="{{ errors is defined and errors['password'] is defined ? 'error-field' : '' }}"
                style="width: 95%;
                    padding: 6px;
                    border: 1px solid #ccc;
                    border-radius: 0;
                    margin-bottom: 5px;" />
            <div id="password_error" class="error-message">{{ errors.password|default('') }}</div>
            
            <label style="display: block; margin-bottom: 12px;">
                <input type="checkbox" name="remember_me" style="vertical-align: middle;" />
                <span style="font-size: 13px; color: #666; border-radius:0px;">Remember Me</span>
            </label>
            
            <button type="submit" 
                name="action" 
                value="login" 
                style="width: 100%;
                    background: linear-gradient(to top, #4B0082, rgb(146, 86, 206));
                    color: white;
                    padding: 6px 0;
                    border: none;
                    border-radius: 0;
                    cursor: pointer;">Sign In</button>
            </form>
        </div>
        
        <div style="text-align: center; font-size: 13px;">
            <a href="#" style="color: #4B0082; text-decoration: none;">Forgot your password?</a>
        </div>
    </div>

    <div style=" border: 1px solid #ccc; padding: 15px;">
        <h3>Site Updates</h3>
        <p>updates and stuff go here</p>
    </div>
</div>
            
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const loginForm = document.getElementById('loginForm');
    
    // Get the input fields and error message elements
    const username = document.getElementById('username');
    const password = document.getElementById('password');
    const usernameError = document.getElementById('username_error');
    const passwordError = document.getElementById('password_error');
    
    // Add input event listeners to clear errors when fields are changed
    username.addEventListener('input', function() {
        username.classList.remove('error-field');
        usernameError.textContent = '';
    });
    
    password.addEventListener('input', function() {
        password.classList.remove('error-field');
        passwordError.textContent = '';
    });
    
    loginForm.addEventListener('submit', function(e) {
        let hasErrors = false;
        
        // Clear previous errors
        username.classList.remove('error-field');
        password.classList.remove('error-field');
        usernameError.textContent = '';
        passwordError.textContent = '';
        
        // Validate username
        if (!username.value.trim()) {
            username.classList.add('error-field');
            usernameError.textContent = 'Email or username cannot be empty';
            hasErrors = true;
        }
        
        // Validate password
        if (!password.value) {
            password.classList.add('error-field');
            passwordError.textContent = 'Password cannot be empty';
            hasErrors = true;
        }
        
        if (hasErrors) {
            e.preventDefault();
        }
    });
});
</script>

</body>
</html>
