<!DOCTYPE html>
<html lang="en">
<head>
    <!-- favicon links remain unchanged -->
    <link rel="icon" type="image/png" href="{{ asset('/favicon/favicon-96x96.png') }}" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="{{ asset('/favicon/favicon.svg') }}" />
    <link rel="shortcut icon" href="{{ asset('/favicon/favicon.ico') }}" />
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('/favicon/apple-touch-icon.png') }}" />
    <link rel="manifest" href="{{ asset('/favicon/site.webmanifest') }}" />
    <link href="{{ asset('styles/app.css') }}" rel="stylesheet">
    <title>connectory</title>
    <style>
        .error-field {
            border: 0.053125rem solid #ff0000 !important;
        }
        .error-message {
            color: #ff0000;
            font-size: 0.64rem;
            margin-bottom: 0.425rem;
        }
    </style>
</head>
<body>
<div class="header">
    <table style="width:100%;">
        <tr>
            <td style="width:50%; text-align:left;">
                <img src="{{ asset('img/logo.png') }}" alt="Logo" style="height:42.5px; padding-bottom:13px;">
            </td>
            <td style="width:50%; text-align:right; vertical-align:top; position:relative;">
                <div style="display: flex; justify-content: flex-end; align-items: start; gap: 13px;">
                    <div style="display: flex; flex-direction: column; align-items: flex-end; margin-right: 13px;">
                        <div style="margin-bottom:4px;">
                            <input type="text" placeholder="Search..." style="padding:4px; width:340px; margin-right:4px;">
                            <button type="button" class="search" style="background: linear-gradient(to top, #4B0082,rgb(146, 86, 206)); color:white; padding:4px 8px; text-decoration:none; border:1px solid #b366ff; font-size: 0.85em;">Search</button>
                        </div>
                        <div style="font-size: 0.85em;">
                            <a href="{{ path('login') }}" style="color:#4B0082; text-decoration:none; margin-right: 8px;">login</a>
                            <a href="{{ path('register') }}" style="color:#4B0082; text-decoration:none;">sign up</a>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
    </table>
</div>

<div class="content" style="background:white; height:85vh;">
    <div style="display:flex; width:100%; height:100%;">
        <div style="flex:1; padding:0.53125rem;">
            <div>
                <div style="border:0.053125rem solid #ccc; padding:0.85rem; height:10.625rem; margin-bottom:1.0625rem;">
                    <h3>Welcome</h3>
                    <p>information about the site and stuff here</p>
                </div>
            </div>
        </div>

        <div style="width: 21.25%; padding:0.53125rem; border-left:0.053125rem solid #eee;">
            <div style="background:#f7f7f7; border:0.053125rem solid #ccc; padding:0.85rem; margin-bottom:1.0625rem;">
                <div style="margin-bottom:0.85rem;">
                    <form method="POST" action="{{ path('auth_handler') }}" id="loginForm">
                        <h3 style="color:#4B0082; font-size:0.74375rem; margin-bottom:0.265625rem;">Email or Username:</h3>
                        <input type="text" 
                            id="username"
                            name="username" 
                            placeholder="example@mail.com" 
                            required 
                            value="{{ last_username|default('') }}"
                            class="{{ errors is defined and errors['username'] is defined ? 'error-field' : '' }}"
                            style="width:95%; padding:0.31875rem; border:0.053125rem solid #ccc; border-radius:0; margin-bottom:0.265625rem;" />
                        <div id="username_error" class="error-message">{{ errors.username|default('') }}</div>
                        
                        <h3 style="color:#4B0082; font-size:0.74375rem; margin-bottom:0.265625rem;">Password:</h3>
                        <input type="password" 
                            id="password"
                            name="password" 
                            required 
                            class="{{ errors is defined and errors['password'] is defined ? 'error-field' : '' }}"
                            style="width:95%; padding:0.31875rem; border:0.053125rem solid #ccc; border-radius:0; margin-bottom:0.265625rem;" />
                        <div id="password_error" class="error-message">{{ errors.password|default('') }}</div>
                        
                        <label style="display:block; margin-bottom:0.6375rem;">
                            <input type="checkbox" name="remember_me" style="vertical-align:middle;" />
                            <span style="font-size:0.690625rem; color:#666;">Remember Me</span>
                        </label>
                        
                        <button type="submit" 
                            name="action" 
                            value="login" 
                            style="width:100%; background:linear-gradient(to top, #4B0082, rgb(146, 86, 206)); color:white; padding:0.31875rem 0; border:none; border-radius:0; cursor:pointer;">Sign In</button>
                    </form>
                </div>
                
                <div style="text-align:center; font-size:0.690625rem;">
                    <a href="#" style="color:#4B0082; text-decoration:none;">Forgot your password?</a>
                </div>
            </div>

            <div style="border:0.053125rem solid #ccc; padding:0.85rem;">
                <h3>Site Updates</h3>
                <p>updates and stuff go here</p>
            </div>
        </div>
    </div>
</div>

<!-- Script remains unchanged -->
</body>
</html>
