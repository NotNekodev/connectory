<!DOCTYPE html>
<html lang="en">
<head>
<link href="{{ asset('styles/app.css') }}" rel="stylesheet">
    <title>connectory</title>

</head>
<body>
<div class="header">
<table>
    <tr>
    <table style="width:100%; padding-top:0px;">
        <tr>
            <td style="width:50%; text-align:left;">
                <img src="{{ asset('img/logo.png') }}" alt="Logo" style="height:50px; padding-bottom:15px;">
            </td>
            <td style="width:50%; text-align:right;">
                <div style="margin-bottom:10px;">
                    <input type="text" placeholder="Search..." style="padding:5px; width:70%;">
                    <button type="button" class="search" style="background: linear-gradient(to top, #4B0082,rgb(146, 86, 206)); color:white; padding:5px 10px; text-decoration:none; border:1px solid #b366ff;">Search</button>
                </div>
                <div style="padding-bottom:10px;">
                    <a href="/link1" style="color:#4B0082; padding:5px 10px; text-decoration:none;">login</a>
                    <a href="/link2" style="color:#4B0082; padding:5px 10px; text-decoration:none;">sign up</a>
                </div>
                
            </td>
        </tr>
        
    </table>
    
</div>
    </tr>
    <tr>
        <td>
            <div class="content" style="background:white; height: 100vh;">
            <div style="display: flex; width: 100%; height: 100%;">
                <!-- Sidebar -->
                <div style="width: 180px; padding: 20px; border-right: 1px solid #eee;">
                    <div style="display:flex; align-items:center;">
                        <img src={{ asset('usr/default.jpg') }} alt="Profile Picture" style="width:50px; margin-right:10px;">
                        <div>
                            <div><strong>Not Logged In</strong></div>
                            <div style="font-size:14px;">Sign Up or Log in</div>
                        </div>
                    </div>
                </div>
                
                <!-- Main content -->
                <div style="flex: 1; padding: 20px;">
                    <div style="align-items:right;">
                        <div class="post" style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px; border-radius: 8px;">
                            <div class="post-header" style="display: flex; align-items: center; margin-bottom: 10px;">
                                <img src="{{ asset('usr/default.jpg') }}" alt="User Profile" style="width: 40px; height: 40px; border-radius: 50%; margin-right: 10px;">
                                <div>
                                    <div style="font-weight: bold;">Username</div>
                                    <div style="color: #666; font-size: 12px;">{{ "now"|date("F j, Y") }}</div>
                                </div>
                            </div>
                            <div class="post-content" style="margin-bottom: 10px;">
                                <p>This is a sample post content. Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
                            </div>
                            <div class="post-actions" style="display: flex; gap: 15px; color: #666;">
                                <div><i class="fa fa-heart"></i> Like</div>
                                <div class="famfamfam-silk key_delete"></div>
                                <div><i class="fa fa-comment"></i> Comment</div>
                                <div><i class="fa fa-share"></i> Share</div>
                            </div>
                        </div>
                    </div>
                    <div style="background:blue">Row 2</div>
                </div>

                <!-- Third column -->
                <div style="width: 300px; padding: 10px; border-left: 1px solid #eee;">
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <div style="border: 1px solid #ccc; padding: 10px;">
                            <h3 style="text-align:center">Site Updates</h3>
                            <p>updates and stuff go here</p>
                        </div>
                        <div style="border: 1px solid #ccc; padding: 0px;">
                            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 10px;">
                                {% for i in 1..4 %}
                                    <div style="text-align: center;">
                                        <img src={{ asset('usr/default.jpg') }} alt="Profile" style="width: 100%; aspect-ratio: 1;">
                                    </div>
                                {% endfor %}
                            </div>
                            <h3 style="text-align: center; margin-top: 10px;">New People</h3>
                        </div>
                        <div style="border: 1px solid #ccc; padding: 10px;">
                            <h3>Box 3</h3>
                            <p>Content for box 3</p>
                        </div>
                    </div>
                </div>
            </div>
            </div>
        </td>
    </tr>
</table>

