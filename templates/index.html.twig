<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/png" href="{{ asset('/favicon/favicon-96x96.png') }}" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="{{ asset('/favicon/favicon.svg') }}" />
    <link rel="shortcut icon" href="{{ asset('/favicon/favicon.ico') }}" />
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('/favicon/apple-touch-icon.png') }}" />
    <link rel="manifest" href="{{ asset('/favicon/site.webmanifest') }}" />
    <link href="{{ asset('styles/app.css') }}" rel="stylesheet">
    <title>connectory</title>
</head>
<body>
<div class="header">
    <table style="width:100%;">
        <tr>
            <td style="width:50%; text-align:left;">
                <img src="{{ asset('img/logo.png') }}" alt="Logo" style="height:50px; padding-bottom:15px;">
            </td>
            <td style="width:50%; text-align:right;">
                <div style="margin-bottom:10px;">
                    <input type="text" placeholder="Search..." style="padding:5px; width:70%;">
                    <button type="button" class="search" style="background: linear-gradient(to top, #4B0082,rgb(146, 86, 206)); color:white; padding:5px 10px; text-decoration:none; border:1px solid #b366ff;">Search</button>
                </div>
                <div style="padding-bottom:10px;">
                    {% if isSignedIn %}
                        <span style="padding:5px 2px; text-decoration:none;"><strong>{{ user }}</strong></span><span style="color:rgb(73,73,73); padding:5px 0; text-decoration:none;">({{ usrtxt2 }})</span><a href="{{ path('logout') }}" style="color:#4B0082; padding:5px 15px; text-decoration:none;">logout</a>
                    {% else %}
                        <a href="{{ path('login') }}" style="color:#4B0082; padding:5px 10px; text-decoration:none;">login</a><a href="{{ path('register') }}" style="color:#4B0082; padding:5px 10px; text-decoration:none;">sign up</a>
                    {% endif %}
                </div>
            </td>
        </tr>
    </table>
</div>

<div class="content" style="background:white; height: 100vh;">
    <div style="display: flex; width: 100%; height: 100%;">
        <!-- Sidebar -->
        <div style="width: 180px; padding: 20px; border-right: 1px solid #eee;">
            <div style="display:flex; align-items:center;">
                <img src="{{ asset('usr/default.jpg') }}" alt="Profile Picture" style="width:50px; margin-right:10px;">
                <div>
                    <div><strong>{{ user }}</strong></div>
                    <div style="font-size:14px;"><p style="color:rgb(73,73,73);">{{ usrtxt2 }}</p></div>
                </div>
            </div>
        </div>

        <!-- Main content -->
        <div style="flex: 1; padding: 20px;">
            <div>
                <div style="border: 1px solid #ccc; padding: 15px;height:200px; margin-bottom: 20px;">

                </div>
            </div>
        </div>

        <!-- Third column -->
        <div style="width: 300px; padding: 10px; border-left: 1px solid #eee;">
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <div style="border: 1px solid #ccc; padding: 10px;">
                    <h3 style="text-align:center">Site Updates</h3>
                    <p>updates and stuff go here</p>
                </div>

                <div style="border: 1px solid #ccc; padding: 10px;">
                    <h3>Box 3</h3>
                    <p>Content for box 3</p>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>